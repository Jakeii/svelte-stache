{
	"name": "svelte-stache",
	"version": "1.2.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "husky && svelte-kit sync",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "vitest",
		"test:run": "vitest run",
		"test:storybook": "vitest --project=storybook",
		"docs:build": "velite && node ./scripts/update-velite-output.js && pnpm build:search && vite build",
		"docs:build:search": "node ./scripts/build-search-data.js",
		"docs:dev": "pnpm \"/docs:dev:/\"",
		"docs:dev:content": "velite dev --watch",
		"docs:dev:svelte": "vite dev",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"files": [
		"dist",
		"!dist/docs",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./devtools": {
			"types": "./dist/devtools/index.d.ts",
			"svelte": "./dist/devtools/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@changesets/cli": "^2.30.0",
		"@chromatic-com/storybook": "^5.0.1",
		"@eslint/js": "^10.0.1",
		"@storybook/addon-a11y": "^10.2.19",
		"@storybook/addon-docs": "^10.2.19",
		"@storybook/addon-mcp": "^0.3.4",
		"@storybook/addon-svelte-csf": "^5.0.11",
		"@storybook/addon-vitest": "^10.2.19",
		"@storybook/sveltekit": "^10.2.19",
		"@svecodocs/kit": "^0.5.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.2.1",
		"@types/node": "^22.19.15",
		"@vitest/browser": "^4.1.10",
		"@vitest/browser-playwright": "^4.1.0",
		"@vitest/coverage-v8": "4.1.0",
		"@vitest/ui": "^4.1.0",
		"eslint": "^10.0.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.2.19",
		"eslint-plugin-svelte": "^3.15.2",
		"globals": "^17.10.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"mdsvex": "^0.12.7",
		"mdsx": "^0.0.7",
		"msw": "^2.12.11",
		"msw-storybook-addon": "^2.0.6",
		"phosphor-svelte": "^3.1.0",
		"playwright": "^1.58.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"publint": "^0.3.18",
		"runed": "^0.37.1",
		"storybook": "^10.2.19",
		"svelte": "^5.55.7",
		"svelte-check": "^4.4.5",
		"tailwindcss": "^4.3.3",
		"type-fest": "^5.4.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.0",
		"velite": "^0.3.1",
		"vite": "^7.3.5",
		"vitest": "^4.1.0"
	},
	"keywords": [
		"svelte"
	],
	"packageManager": "pnpm@10.28.2",
	"lint-staged": {
		"*.{ts,svelte,js}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{json,css,scss,md}": [
			"prettier --write"
		]
	}
}
