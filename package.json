{
	"name": "svelte-stache",
	"version": "1.5.0",
	"license": "MIT",
	"repository": "https://github.com/Jakeii/svelte-stache",
	"bugs": "https://github.com/Jakeii/svelte-stache/issues",
	"homepage": "https://svelte-stache.pages.dev/docs",
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm docs:build && vite build && pnpm prepack",
		"preview": "vite preview",
		"prepare": "husky && svelte-kit sync",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "vitest",
		"test:run": "vitest run",
		"test:storybook": "vitest --project=storybook",
		"docs:build": "pnpm docs:build:content && pnpm \"/docs:build:(search|llms)/\" && vite build",
		"docs:build:content": "velite && node ./scripts/update-velite-output.js",
		"docs:build:search": "node ./scripts/build-search-data.js",
		"docs:build:llms": "node ./scripts/build-llms-txt.js",
		"docs:dev": "pnpm \"/docs:dev:/\"",
		"docs:dev:content": "velite dev --watch",
		"docs:dev:svelte": "vite dev",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"files": [
		"dist",
		"!dist/docs",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./devtools": {
			"types": "./dist/devtools/index.d.ts",
			"svelte": "./dist/devtools/index.js"
		},
		"./utils": {
			"types": "./dist/utils/index.d.ts",
			"svelte": "./dist/utils/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@chromatic-com/storybook": "^5.3.0",
		"@eslint/js": "^10.0.1",
		"@storybook/addon-a11y": "^10.6.8",
		"@storybook/addon-docs": "^10.6.8",
		"@storybook/addon-mcp": "^10.6.8",
		"@storybook/addon-svelte-csf": "^5.1.6",
		"@storybook/addon-vitest": "^10.6.8",
		"@storybook/sveltekit": "^10.6.8",
		"@svecodocs/kit": "^0.5.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^24.19.2",
		"@vitest/browser": "^5.1.1",
		"@vitest/browser-playwright": "^5.1.1",
		"@vitest/coverage-v8": "5.1.1",
		"@vitest/ui": "^5.1.1",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.6.3",
		"eslint-plugin-svelte": "^3.15.2",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.2",
		"mdsvex": "^0.12.7",
		"mdsx": "^0.0.7",
		"msw": "^2.12.11",
		"msw-storybook-addon": "^2.0.6",
		"phosphor-svelte": "^3.1.0",
		"playwright": "^1.63.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"publint": "^0.3.25",
		"runed": "^0.37.1",
		"storybook": "^10.6.8",
		"svelte": "^5.57.3",
		"svelte-check": "^4.4.5",
		"tailwindcss": "^4.3.3",
		"type-fest": "^6.0.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.74.0",
		"velite": "^0.4.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"keywords": [
		"svelte"
	],
	"packageManager": "pnpm@12.21.0",
	"lint-staged": {
		"*.{ts,svelte,js}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{json,css,scss,md}": [
			"prettier --write"
		]
	}
}
